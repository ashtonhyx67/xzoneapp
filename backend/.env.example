# Railway provides this automatically once you add a PostgreSQL service.
# For local dev, point it at a local Postgres instance.
DATABASE_URL=postgresql://user:password@localhost:5432/team_app

# Any long random string. Generate one with: openssl rand -hex 32
JWT_SECRET=replace-this-with-a-long-random-string

# WebAuthn (Face ID) settings.
# Locally, leave these as-is. In production on Railway, set:
#   RP_ID=your-app-name.up.railway.app   (no https://, no trailing slash)
#   ORIGIN=https://your-app-name.up.railway.app
RP_ID=localhost
ORIGIN=http://localhost:5173

NODE_ENV=development
PORT=4000

# Who owns this instance. That account is always an admin, whenever it is
# created, and its admin access cannot be revoked from setAdmin.js.
OWNER_EMAIL=ashtonhengyongxin@gmail.com
